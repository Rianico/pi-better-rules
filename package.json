{
  "name": "pi-better-rules",
  "version": "0.2.1",
  "description": "Pi extension that surfaces global and project rules per prompt (spec .scratch/rules-extension/spec.md §5; loader manifest: package.json ‘pi.extensions’ -> ./src/index.ts per docs/extensions.md + docs/packages.md).",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src tests",
    "build": "tsc"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24.0.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "semantic-release": "^25.0.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.32.1",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
