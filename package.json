{
	"name": "pi-better-rules",
	"version": "0.0.0",
	"private": true,
	"description": "Pi extension that surfaces global and project rules per prompt (spec .scratch/rules-extension/spec.md \u00a75; loader manifest: package.json \u2018pi.extensions\u2019 -> ./src/index.ts per docs/extensions.md + docs/packages.md).",
	"keywords": [
		"pi-package"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"type": "module",
	"packageManager": "pnpm@10.32.1",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"lint": "biome check src tests",
		"build": "tsc"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@types/node": "^24.0.0",
		"tsx": "^4.20.0",
		"typescript": "^5.9.0",
		"vitest": "^3.2.0"
	}
}
